/* MARK: tutorial */
"tutorial.cheat.call.body" = "If you think somebody lied, say so. If you are right they take the pile; if you are wrong, you do.";
"tutorial.cheat.call.title" = "Or call it";
"tutorial.cheat.count.body" = "Four of each rank exist. If you hold three and they claim two, one of those is a lie.";
"tutorial.cheat.count.title" = "Count";
"tutorial.cheat.goal.body" = "Put cards down claiming a rank. They do not have to be that rank.";
"tutorial.cheat.goal.title" = "Get rid of them";
"tutorial.cheat.lay.body" = "Put one to four cards face down and say what they are.";
"tutorial.cheat.lay.title" = "Claim";
"tutorial.crazy8.draw.body" = "Then you draw. Keep drawing until something fits.";
"tutorial.crazy8.draw.title" = "Nothing goes?";
"tutorial.crazy8.eights.body" = "An eight can be played on anything — and you say what suit comes next.";
"tutorial.crazy8.eights.title" = "Eights are wild";
"tutorial.crazy8.finish.body" = "Play out the rest of the hand. Whoever empties first takes the deal.";
"tutorial.crazy8.finish.title" = "Finish the deal";
"tutorial.crazy8.goal.body" = "Play every card in your hand before anybody else does.";
"tutorial.crazy8.goal.title" = "Get rid of them all";
"tutorial.crazy8.match.body" = "Play a card that matches the suit or the rank of the one on the pile. Tap one.";
"tutorial.crazy8.match.title" = "Match it";
"tutorial.euchre.alone.body" = "Sit your partner out and take all five for four points. Or get euchred for two.";
"tutorial.euchre.alone.title" = "Going alone";
"tutorial.euchre.bowers.body" = "The jack of trumps is the best card. The jack of the same colour is the second best — and it counts as trump.";
"tutorial.euchre.bowers.title" = "The bowers";
"tutorial.euchre.goal.body" = "Three of the five wins the hand. Twenty-four cards, four players, two teams.";
"tutorial.euchre.goal.title" = "Five tricks";
"tutorial.euchre.order.body" = "Order the dealer to take the turned card, or pass and name a suit yourself.";
"tutorial.euchre.order.title" = "Name trump";
"tutorial.freecell.cells.body" = "Each one holds a single card. Each empty one doubles what you can move at once.";
"tutorial.freecell.cells.title" = "Four cells";
"tutorial.freecell.goal.body" = "Every card is face up from the start. Almost every deal can be won.";
"tutorial.freecell.goal.title" = "Everything visible";
"tutorial.freecell.lift.body" = "Down in alternating colours, as before. Move one now.";
"tutorial.freecell.lift.title" = "Move a run";
"tutorial.gin.discard.body" = "End your turn by discarding. Throw high, and avoid what they are collecting.";
"tutorial.gin.discard.title" = "Throw one";
"tutorial.gin.draw.body" = "From the stock, or from the discard pile — but taking the discard tells your opponent what you want.";
"tutorial.gin.draw.title" = "Take one";
"tutorial.gin.goal.body" = "Three of a rank, or three in sequence in a suit. Everything else is deadwood.";
"tutorial.gin.goal.title" = "Sets and runs";
"tutorial.gin.knock.body" = "Under ten deadwood and you can end the hand. Zero is gin, and worth more.";
"tutorial.gin.knock.title" = "Knock";
"tutorial.gin.melds.body" = "Aces are one, faces are ten. Get your deadwood down to ten and you can knock.";
"tutorial.gin.melds.title" = "What counts";
"tutorial.gofish.ask.body" = "You may only ask for a rank you already hold. Everybody hears the question.";
"tutorial.gofish.ask.title" = "Ask somebody";
"tutorial.gofish.books.body" = "What other people ask for tells you what they hold. That is the whole game.";
"tutorial.gofish.books.title" = "Listen";
"tutorial.gofish.goal.body" = "Collect four of a rank to make a book. Most books wins.";
"tutorial.gofish.goal.title" = "Four of a kind";
"tutorial.hearts.follow.body" = "If you hold the suit that was led, you must play it. Play one now.";
"tutorial.hearts.follow.title" = "Follow the suit";
"tutorial.hearts.goal.body" = "Every heart is a point against you and the Queen of Spades is thirteen. Low score wins.";
"tutorial.hearts.goal.title" = "Take nothing";
"tutorial.hearts.moon.body" = "Take all twenty-six and everybody else gets them instead. It rarely works. It is worth trying.";
"tutorial.hearts.moon.title" = "Or take everything";
"tutorial.hearts.pass.body" = "Choose three cards to give away. High spades and a short suit are the usual answer.";
"tutorial.hearts.pass.title" = "Pass three";
"tutorial.hearts.queen.body" = "Thirteen points in one card. Get rid of her the moment you cannot win the trick.";
"tutorial.hearts.queen.title" = "The Queen";
"tutorial.klondike.foundation.body" = "An ace starts a foundation, then twos, then threes. Do not send them up too early.";
"tutorial.klondike.foundation.title" = "Send them home";
"tutorial.klondike.goal.body" = "Build all four suits up from the ace. That is the whole game.";
"tutorial.klondike.goal.title" = "Ace to king";
"tutorial.klondike.kings.body" = "An empty column takes a king and nothing else. Save one.";
"tutorial.klondike.kings.title" = "Kings only";
"tutorial.klondike.stock.body" = "When nothing on the table moves, turn a card.";
"tutorial.klondike.stock.title" = "Turn the stock";
"tutorial.klondike.tableau.body" = "Red on black, black on red, one rank at a time. Move a card now.";
"tutorial.klondike.tableau.title" = "Down, alternating";
"tutorial.poker.act.body" = "Fold, call or raise. Position matters as much as the cards do.";
"tutorial.poker.act.title" = "Your move";
"tutorial.poker.blinds.body" = "Two players put money in before anyone has seen a card. That is what there is to play for.";
"tutorial.poker.blinds.title" = "Blinds";
"tutorial.poker.board.body" = "Three cards, then one, then one. Betting between each.";
"tutorial.poker.board.title" = "The board";
"tutorial.poker.goal.body" = "Make the best five from your two and the five in the middle. Or make everybody else fold.";
"tutorial.poker.goal.title" = "Two cards each";
"tutorial.poker.ranking.body" = "Straight flush, quads, full house, flush, straight, trips, two pair, pair, high card.";
"tutorial.poker.ranking.title" = "What beats what";
"tutorial.poker.showdown.body" = "Everybody still in turns their cards over. Best hand takes the pot.";
"tutorial.poker.showdown.title" = "Showdown";
"tutorial.president.goal.body" = "Shed your hand. First is President; last is Scum.";
"tutorial.president.goal.title" = "First out wins";
"tutorial.president.pass.body" = "When everybody passes, the pile is cleared and whoever played last leads.";
"tutorial.president.pass.title" = "Passing is fine";
"tutorial.president.sets.body" = "Play the same number of cards, of a higher rank. Or pass.";
"tutorial.president.sets.title" = "Beat the pile";
"tutorial.president.swap.body" = "Next deal, the Scum hands their two best cards to the President. That is the sting.";
"tutorial.president.swap.title" = "The exchange";
"tutorial.rummy.goal.body" = "Three of a rank, or three in sequence in a suit. Get rid of everything.";
"tutorial.rummy.goal.title" = "Melds";
"tutorial.rummy.layoff.body" = "You can add to anybody's meld, including your opponents'.";
"tutorial.rummy.layoff.title" = "Lay off";
"tutorial.rummy.meld.body" = "Melding banks the cards — and shows the table what you are collecting.";
"tutorial.rummy.meld.title" = "Lay it down";
"tutorial.rummy.out.body" = "Discard your last card and the hand ends. Everybody else counts what they are holding.";
"tutorial.rummy.out.title" = "Going out";
"tutorial.spades.bags.body" = "Every trick past your bid is a bag. Ten bags costs a hundred points.";
"tutorial.spades.bags.title" = "Watch the bags";
"tutorial.spades.bid.body" = "Count aces, guarded kings and every spade past the third.";
"tutorial.spades.bid.title" = "Your bid";
"tutorial.spades.goal.body" = "Bid the tricks you will take, then take exactly that many. Partnership game.";
"tutorial.spades.goal.title" = "Say a number";
"tutorial.spades.trump.body" = "A spade beats any other suit. You cannot lead one until somebody has thrown one away.";
"tutorial.spades.trump.title" = "Spades win";
"tutorial.speed.adjacent.body" = "A seven goes on a six or an eight. Aces join kings and twos.";
"tutorial.speed.adjacent.title" = "One above or below";
"tutorial.speed.goal.body" = "Both of you play at once, onto the same two piles.";
"tutorial.speed.goal.title" = "No turns";
"tutorial.speed.stuck.body" = "When neither of you can move, a new card goes on each pile.";
"tutorial.speed.stuck.title" = "Both stuck";
"tutorial.spider.deal.body" = "When nothing moves, deal ten more — but every column has to have a card in it first.";
"tutorial.spider.deal.title" = "Deal a row";
"tutorial.spider.goal.body" = "Clear king to ace in a single suit, eight times.";
"tutorial.spider.goal.title" = "Eight runs";
"tutorial.spider.suits.body" = "You can stack any card on one a rank higher, but only a same-suit run moves as a unit.";
"tutorial.spider.suits.title" = "Same suit";
"tutorial.war.flip.body" = "That is the whole move. Tap.";
"tutorial.war.flip.title" = "Turn one";
"tutorial.war.goal.body" = "Split the pack, turn one each, higher card takes both.";
"tutorial.war.goal.title" = "Highest card wins";
"tutorial.war.war.body" = "A tie means three cards face down and one up. Winner takes the lot.";
"tutorial.war.war.title" = "War";

/* MARK: hint (war) */
"hint.war.noChoice" = "There is nothing to decide in War — that is the game. Turn the card.";
