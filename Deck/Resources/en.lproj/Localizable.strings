/* MARK: hint */
"hint.cheat.count" = "You hold %@ of that rank. The more you hold, the less likely their claim is — and the bigger the pile, the more a wrong call costs.";
"hint.cheat.impossible" = "You hold %@ of them and they claimed %@. There are only four in the pack, so at least one of those is a lie.";
"hint.cheat.mustLie" = "You have no %@s, so whatever you put down is a lie. Lay one card, not three — a small lie is a smaller loss.";
"hint.cheat.truth" = "You can play %@ honestly. Getting rid of cards matters, but so does keeping a rank back for when you are forced to lie later.";
"hint.crazy8.matches" = "These %@ cards match the suit or the rank. Saving your eight for a suit you cannot follow is usually worth more than playing it now.";
"hint.crazy8.mustDraw" = "Nothing in your hand matches %@ or the top rank, so you draw.";
"hint.crazy8.onlyWild" = "Only your eight will go. Nominate the suit you hold most of.";
"hint.crazy8.penalty" = "A two was played against you. Take %@ cards before you can play again.";
"hint.euchre.bidding" = "Count the bowers, not the suits: with the jack of %@ and the other jack of the same colour you already hold the two best cards. You have %@ cards that would be trump.";
"hint.euchre.discard" = "Throw a singleton in a side suit if you can — being void lets you trump in later.";
"hint.euchre.follow" = "Three tricks out of five is all the makers need. Work out which side is short and play to that.";
"hint.euchre.trumping" = "Remember the left bower counts as trump, not as its printed suit. Spending a bower to take a trick nobody was contesting is how hands get euchred.";
"hint.freecell.cellsFull" = "Every cell is full, so you can only move one card at a time. Emptying a cell is more urgent than anything else on the board.";
"hint.freecell.emptyColumn" = "An empty column doubles what you can lift — you can move %@ cards. Filling it costs you that, so think before you park a king there.";
"hint.freecell.plan" = "Dig for the aces first. Every card you send up is one fewer thing the cells have to hold.";
"hint.freecell.stuck" = "Nothing moves. Undo back to the last point where a cell was free — that is almost always where it went wrong.";
"hint.gin.canKnock" = "You are down to %@ deadwood, so you can knock. Knocking small wins small; holding on for gin wins more and loses badly to an undercut.";
"hint.gin.discardHigh" = "Your deadwood is %@. Throw the highest card that is not part of anything — and prefer one your opponent has shown no interest in.";
"hint.gin.drawStock" = "The upcard does not help, and taking it would tell your opponent what you are building. Draw blind.";
"hint.gin.takeDiscard" = "That card cuts your deadwood by %@. Taking it also tells your opponent what you are collecting — worth it here.";
"hint.gofish.listen" = "Somebody already asked for %@s, so they hold at least one. You hold one too — ask them.";
"hint.gofish.nearBook" = "You are closest to a book of %@s. Asking for what you hold most of finishes books fastest.";
"hint.hearts.discard" = "You are void, so nothing you play can win this trick. That makes it the moment to get rid of the Queen of Spades or a high heart.";
"hint.hearts.follow" = "You hold %@, so you must follow. Play under the highest card already down and you cannot take the trick.";
"hint.hearts.lead" = "Hearts are not broken, so you lead a black or diamond card. Leading low keeps you off the trick.";
"hint.hearts.leadOpen" = "Leading a low card keeps the trick away from you. Whoever wins it takes whatever is in it.";
"hint.hearts.passing" = "Pass your high spades if you hold fewer than three, and dump a whole short suit so you can discard into it later.";
"hint.klondike.draw" = "Nothing on the tableau moves the game forward, so turn the stock and see what it gives you.";
"hint.klondike.emptyColumn" = "Clearing this column gives you somewhere to put a king. That is worth more right now than another card on a foundation.";
"hint.klondike.foundation" = "These can go up to a foundation. Sending low cards early is safe; hold a card back only while a lower one of the opposite colour still needs somewhere to sit.";
"hint.klondike.shuffleAround" = "Only sideways moves are left. Prefer the one that exposes a face-down card, even if it looks like less progress.";
"hint.klondike.stuck" = "There is no legal move left. This deal cannot be finished — deal a new one.";
"hint.klondike.turnUp" = "Moving this run turns up the card underneath it. Uncovering cards is worth more than anything else on the board.";
"hint.poker.made" = "You hold %@. Betting is how you get paid; checking a strong hand only helps opponents catch up for free.";
"hint.poker.offsuit" = "Unpaired, unsuited cards need help from the board. Position matters more than the cards here.";
"hint.poker.pair" = "A pocket pair is already a made hand. It plays well against one or two opponents and badly against five.";
"hint.poker.potOdds" = "You hold %@. Calling %@ into %@ means you need to win about %@% of the time to break even.";
"hint.poker.suited" = "Suited cards make a flush about one time in sixteen by the river — worth a call in position, not worth a big raise.";
"hint.president.hold" = "Passing when you could play is often right: whoever plays last leads next, and leading is worth more than shedding one card.";
"hint.president.lead" = "You have the lead, so you choose the size. Leading a pair or a triple burns other players' matching cards while you still hold singles to finish with.";
"hint.president.mustPass" = "Nothing you hold beats that, so you pass. Once everybody passes, whoever played last leads again.";
"hint.rummy.canMeld" = "You can lay %@ meld(s) down. Melding banks the points but tells everybody what you are collecting, and lets them lay off on you.";
"hint.rummy.discardHigh" = "Throw the high card that is doing the least work. Watch what your opponents pick up — anything near it is dangerous.";
"hint.rummy.drawStock" = "The discard does not finish anything. Draw blind and keep your intentions to yourself.";
"hint.rummy.takeDiscard" = "That card completes a meld. Taking from the discard pile shows your hand though — think about whether it is worth the read.";
"hint.spades.bags" = "You already have your %@. Extra tricks become bags, and ten bags costs a hundred points — duck from here.";
"hint.spades.bidding" = "Count your certain tricks: aces, guarded kings, and every spade past the third. You hold %@ spades and %@ aces.";
"hint.spades.contract" = "You still need %@. Spades beat everything, so a low spade on a suit you are void in is a trick nobody can take from you.";
"hint.spades.nil" = "You bid nil, so every trick is a disaster. Play your highest losing card and stay off the lead.";
"hint.speed.playable" = "You have %@ cards that fit. Playing the one that leaves you a follow-up on the same pile is worth more than playing the first one you see.";
"hint.speed.stuck" = "Nothing in your hand fits either pile. Watch for the moment your opponent changes one — that is when your card becomes playable.";
"hint.spider.empty" = "An empty column is the most valuable thing on the board. Use it to unpick a mixed pile, not to park a king you cannot move again.";
"hint.spider.sameSuit" = "Building in the same suit is what actually wins Spider — a mixed pile looks tidy and cannot be moved. Prefer the move that keeps a suit together, even if it uncovers less.";
"hint.spider.stuck" = "Nothing moves and there is no row left to deal. Undo, or start a new deal.";
"hint.spider.uncover" = "There are %@ cards still face down. Uncovering them beats tidying the columns you can already see.";

