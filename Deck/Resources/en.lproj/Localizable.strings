/* MARK: game */
"game.crazyEights.name" = "Crazy Eights";
"game.crazyEights.tagline" = "Match the suit, match the rank, or play an eight.";
"game.crazyEights.description" = "Shed your hand by matching the card on the pile. Eights are wild and their player names the next suit.";
"game.hearts.name" = "Hearts";
"game.hearts.tagline" = "Win nothing. That is the whole idea.";
"game.hearts.description" = "Every heart costs a point and the Queen of Spades costs thirteen. Take all twenty-six and you shoot the moon.";
"game.spades.name" = "Spades";
"game.spades.tagline" = "Say how many. Then take exactly that many.";
"game.spades.description" = "Partnership bidding with spades always trump. Miss your bid and it hurts; beat it too often and the bags will get you.";
"game.euchre.name" = "Euchre";
"game.euchre.tagline" = "Twenty-four cards and two jacks that change everything.";
"game.euchre.description" = "The jack of trumps and the jack of its colour are the two best cards in the pack. Three tricks out of five wins the hand.";
"game.texasHoldem.name" = "Texas Hold'em";
"game.texasHoldem.tagline" = "Two cards, five on the board, no limit.";
"game.texasHoldem.description" = "Blinds, position, four rounds of betting and a showdown. Side pots, split pots and all-ins all work the way they do at a table.";
"game.ginRummy.name" = "Gin Rummy";
"game.ginRummy.tagline" = "Take the card you can see, or the one you cannot.";
"game.ginRummy.description" = "Build sets and runs, and knock when your deadwood is down to ten. Go for gin and an undercut will cost you.";
"game.rummy.name" = "Rummy";
"game.rummy.tagline" = "Sets, runs, and knowing when to lay them down.";
"game.rummy.description" = "Draw, meld, lay off and discard. Melding banks points and tells everybody what you are collecting.";
"game.president.name" = "President";
"game.president.tagline" = "Get out first. Stay out of last.";
"game.president.description" = "Play sets that beat the pile or pass. Finish first and you are President; finish last and you hand over your best cards.";
"game.klondike.name" = "Klondike";
"game.klondike.tagline" = "The one everybody means by solitaire.";
"game.klondike.description" = "Seven columns, four foundations and a stock you turn one or three at a time. Undo is unlimited.";
"game.freeCell.name" = "FreeCell";
"game.freeCell.tagline" = "Everything face up. Nowhere to hide.";
"game.freeCell.description" = "Four cells, eight columns, and almost every deal can be won. Each empty cell doubles what you can move at once.";
"game.spider.name" = "Spider";
"game.spider.tagline" = "Two packs. Eight runs. One suit at a time.";
"game.spider.description" = "Build down to untangle the columns, then clear king-to-ace in a single suit. One suit is gentle; four is not.";
"game.goFish.name" = "Go Fish";
"game.goFish.tagline" = "Ask, and listen to what everybody else asks.";
"game.goFish.description" = "Collect four of a kind. Every question is public, which is more information than it sounds.";
"game.war.name" = "War";
"game.war.tagline" = "No decisions. That is the point.";
"game.war.description" = "Highest card takes both. A tie means war: three down, one up, winner takes the lot.";
"game.cheat.name" = "Cheat";
"game.cheat.tagline" = "Say what you like. Somebody has to believe you.";
"game.cheat.description" = "Put cards face down and claim a rank. Call it wrong and the whole pile is yours.";
"game.speed.name" = "Speed";
"game.speed.tagline" = "Both of you. At once. Now.";
"game.speed.description" = "No turns: reach for the same two piles and play one rank above or below. First to empty out wins.";
